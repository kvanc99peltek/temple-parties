# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URL (share links, Open Graph, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog analytics (optional in local; required for prod analytics)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Enable Auth V2 flow (recommended for deterministic callback handling)
NEXT_PUBLIC_AUTH_V2=true

# Auth redirect URL for magic links (must be in Supabase redirect allowlist)
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
