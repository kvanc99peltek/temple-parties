# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URL (share links, Open Graph, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog analytics (optional in local; required for prod analytics)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# NOTE (Epic 3.8): NEXT_PUBLIC_AUTH_V2 and NEXT_PUBLIC_AUTH_REDIRECT_URL were
# retired — auth is email OTP via the backend, not magic-link /auth/callback.
